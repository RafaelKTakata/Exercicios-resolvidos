# 1. Par ou ímpar
n = int(input("Número: "))
if n % 2 == 0:
    print("Par")
else:
    print("Ímpar")


# 2. Passa ou reprova
n1 = float(input("Nota 1: "))
n2 = float(input("Nota 2: "))
n3 = float(input("Nota 3: "))
media = (n1 + n2 + n3) / 3
if media >= 9.5:
    print("Passa")
else:
    print("Reprova")


# 3. Voto e desconto de jovem
idade = int(input("Idade: "))
if idade >= 18:
    print("Pode votar")
if idade < 26:
    print("Tem desconto de jovem")


# 4. O maior de dois números, sem if
a = float(input("Primeiro número: "))
b = float(input("Segundo número: "))
print(max(a, b))