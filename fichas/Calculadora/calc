def calculadora_basica():
    print("----Calculadora----")
    
    
    while True:
    
        print("\nEscolhe uma operação:")
        print("1 - Adição (+)")
        print("2 - Subtração (-)")
        print("3 - Multiplicação (*)")
        print("4 - Divisão (/)")
        print("0 - Sair")
        
        opcao = input("\nOpção: ").strip()
        
        if opcao == "0":
            print("\nCalculadora encerrada")
            break

        if opcao == "1":
            num1 = float(input("\nDigite o primeiro número: "))
            num2 = float(input("Digite o segundo número: "))
            resultado = num1 + num2
            print(resultado)

        if opcao == "2":
                    num1 = float(input("\nDigite o primeiro número: "))
                    num2 = float(input("Digite o segundo número: "))
                    resultado = num1 - num2
                    print("Resultado:",resultado)
        
        if opcao == "3":
                    num1 = float(input("\nDigite o primeiro número: "))
                    num2 = float(input("Digite o segundo número: "))
                    resultado = num1 * num2
                    print("Resultado:",resultado)
                    
        if opcao == "4":
                    num1 = float(input("\nDigite o primeiro número: "))
                    num2 = float(input("Digite o segundo número: "))
                    resultado = num1 / num2
                    print("Resultado:",resultado)
calculadora_basica()
        
